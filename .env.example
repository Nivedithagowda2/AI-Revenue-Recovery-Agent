# ---- Server ----
PORT=3000

# ---- Razorpay (test mode keys from Dashboard > Settings > API Keys) ----
RAZORPAY_KEY_ID="your Razorpay Key ID"
RAZORPAY_KEY_SECRET="your Razorpay Key Secret"
# Dashboard > Settings > Webhooks > your webhook > Secret
RAZORPAY_WEBHOOK_SECRET=

# ---- Twilio WhatsApp (Sandbox is fine for a hackathon demo) ----
# https://console.twilio.com -> Messaging -> Try WhatsApp
TWILIO_ACCOUNT_SID="your Twilio Account SID"
TWILIO_AUTH_TOKEN="your Twilio Auth Token"
TWILIO_WHATSAPP_FROM="your Twilio WhatsApp sandbox number, e.g. whatsapp:+14155238886"

# ---- Behaviour ----
# If any of the above are blank, the agent runs in MOCK mode automatically:
# it still creates a real-looking payment link record and logs the exact
# WhatsApp message it *would* send, so the full flow is demoable without keys.
# Set to "true" to force mock mode even if keys are present.
FORCE_MOCK=false


TEST_RECIPIENT_PHONE="your_phone_number"

# ---- Twilio Voice (optional, for the "Call" button / voice recovery) ----
# Must be a Twilio phone number with Voice capability (Console > Phone
# Numbers > Buy a number, or an existing number on your account).
# The WhatsApp sandbox number is NOT voice-capable, so this is separate.
TWILIO_VOICE_FROM=

# Recovery policy knobs
MAX_RETRIES_PER_ENTITY=2
MAX_CONTACTS_PER_24H=1
CHECKOUT_ABANDON_MINUTES=20
